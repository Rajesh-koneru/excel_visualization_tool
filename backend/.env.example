# Server Configuration
PORT=5000

# Database Configuration
# Option 1: Local MongoDB (Requires MongoDB running on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/Excel_analysis

# Option 2: Free Cloud MongoDB Atlas (Recommended if local MongoDB is not installed)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Excel_analysis?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_secret_key_here

# File Upload Limits (in Megabytes)
MAX_FILE_SIZE_MB=10

# AI Data Assistant Configuration (Google Gemini Free Tier)
# Get a free Gemini API key from https://aistudio.google.com/
AI_API_KEY=your_free_ai_api_key_here
AI_MODEL=gemini-1.5-flash
